{
  "version": 2,
  "name": "loango-frontend",
  "buildCommand": "npm install -g pnpm && pnpm install --frozen-lockfile && pnpm --filter @workspace/mobile run build",
  "outputDirectory": "artifacts/mobile/dist",
  "routes": [
    { "src": "/_expo/static/(.*)", "dest": "/_expo/static/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
